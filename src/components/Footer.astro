---
const columns = [
  {
    title: 'Nous connaître',
    links: [
      { href: '/a-propos/', label: 'Qui sommes-nous' },
      { href: '/guide-achat/', label: "Guide d'achat" },
      { href: '/faq/', label: 'FAQ' },
      { href: '/actualites/', label: 'Actualités' },
    ],
  },
  {
    title: 'Nos services',
    links: [
      { href: '/rachat-de-bijoux/', label: 'Rachat de bijoux' },
      { href: '/contact/', label: 'Nous contacter' },
    ],
  },
  {
    title: 'Légal',
    links: [
      { href: '/mentions-legales/', label: 'Mentions légales' },
      { href: '/politique-de-confidentialite/', label: 'Politique de confidentialité' },
      { href: '/cgv/', label: 'CGV' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="wrap footer-top">
    <a class="logo" href="/">
      <img src="/images/logo.png" alt="Acheter Argent" width="198" height="39" />
    </a>
    <p>Achetez des pièces et lingots d'argent physique en toute confiance.</p>
  </div>
  <div class="wrap footer-grid">
    {columns.map((col) => (
      <div>
        <h4>{col.title}</h4>
        <ul>{col.links.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}</ul>
      </div>
    ))}
  </div>
  <div class="wrap footer-bottom">
    <p>Acheter Argent est édité par NEWP.</p>
    <p>Vous cherchez à vendre plutôt qu'à acheter ? Voir <a href="https://acheter-vendre-argent.fr/" rel="noopener">acheter-vendre-argent.fr</a>.</p>
    <p>&copy; {new Date().getFullYear()} Acheter Argent. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding: 56px 0 24px; margin-top: 70px; }
  .footer-top { max-width: 480px; margin-bottom: 36px; }
  .footer-top .logo { display: block; margin-bottom: 10px; }
  .footer-top .logo img { height: 24px; width: auto; display: block; }
  .footer-top .logo:hover { text-decoration: none; }
  .footer-top p { margin: 0; font-size: 14px; }
  .footer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .footer-grid h4 { font-size: 13px; margin-bottom: 12px; color: #fff; font-family: var(--sans); text-transform: uppercase; letter-spacing: .06em; }
  .footer-grid ul { list-style: none; margin: 0; padding: 0; }
  .footer-grid li { margin: 8px 0; }
  .footer-grid a { color: var(--mut); font-size: 14px; }
  .footer-grid a:hover { color: var(--accent); }
  .footer-bottom { border-top: 1px solid var(--line); margin-top: 34px; padding-top: 18px; }
  .footer-bottom p { font-size: 12.5px; margin: 4px 0; color: #6f6a60; }
  @media (max-width: 780px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
