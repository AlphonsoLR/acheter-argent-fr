---
const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/guide-achat/', label: "Guide d'achat" },
  { href: '/actualites/', label: 'Actualités' },
  { href: '/faq/', label: 'FAQ' },
];
---
<div class="pill-nav-wrap">
  <header class="pill-nav">
    <a class="logo" href="/">
      <span class="dot"></span>
      Acheter Argent
    </a>
    <nav class="pill-nav-links">
      {nav.map((item) => (<a href={item.href}>{item.label}</a>))}
    </nav>
    <a class="btn" href="/contact/">Nous contacter</a>
  </header>
</div>
