---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 22 } = Astro.props;

// Set d'icônes trait fin (style Feather/Lucide), dessinées à la main, aucune dépendance externe.
const icons: Record<string, string> = {
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  calendar: '<path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/>',
  'map-pin': '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  package: '<path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v9"/>',
  truck: '<rect x="1" y="3" width="13" height="13"/><path d="M14 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>',
  banknote: '<rect x="2" y="6" width="20" height="12" rx="1"/><circle cx="12" cy="12" r="3"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 4.5v15z"/><path d="M6.5 17H20v3H6.5A2.5 2.5 0 0 1 4 17.5"/>',
  newspaper: '<path d="M4 4h13a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H4V4z"/><path d="M8 8h8M8 12h8M8 16h4"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  'chevron-right': '<path d="M9 18l6-6-6-6"/>',
  building: '<path d="M3 22V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M15 8h5a1 1 0 0 1 1 1v13M3 22h19"/>',
};

const inner = icons[name] ?? '';
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon"
  aria-hidden="true"
  set:html={inner}
/>

<style>
  .icon { display: inline-block; vertical-align: middle; flex: 0 0 auto; }
</style>
