---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('actualites')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Actualités — Cours de l'argent | Acheter Argent"
  description="Analyses de marché et actualités sur l'argent physique et la numismatique."
  path="/actualites/"
>
  <section class="page-hero" style="background-image:url('/images/silver-bar.jpg')">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Accueil</a> / Actualités</p>
      <h1>Actualités & <em>analyses de marché</em></h1>
      <p class="lead">Cours de l'argent, conseils d'investissement et actualités numismatiques.</p>
    </div>
  </section>

  <div class="wrap section">
    <div class="divided-list">
      {posts.map((post) => (
        <a class="article-row" href={`/actualites/${post.id}/`}>
          <div class="icon-circle"><Icon name="newspaper" /></div>
          <div class="article-body">
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .article-row { display: flex; gap: 16px; align-items: flex-start; color: var(--ink); }
  .article-row:hover { text-decoration: none; }
  .article-row:hover h3 { color: var(--accent); }
  .article-body { flex: 1; }
  .article-body h3 { margin: 0 0 6px; transition: color .15s; }
  .article-body p { margin: 0 0 6px; }
  .article-body time { font-size: 12.5px; color: var(--mut); }
</style>
