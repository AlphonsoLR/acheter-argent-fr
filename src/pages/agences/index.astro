---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const agences = [
  { ville: 'Paris (Siège)', adresse: '26 rue Vivienne, 75002 Paris' },
  { ville: 'Aix-en-Provence', adresse: '33 rue Espariat, 13100 Aix-en-Provence' },
  { ville: 'Marseille', adresse: '65 rue Saint Ferréol, 13006 Marseille' },
  { ville: 'Lyon', adresse: '28 avenue du Maréchal de Saxe, 69006 Lyon' },
  { ville: 'Nice', adresse: "27 rue de l'Hôtel des Postes, 06000 Nice" },
];
---
<BaseLayout
  title="Nos agences | Godot & Fils"
  description="Le réseau Godot & Fils compte plus de 200 agences en France pour acheter de l'argent physique en toute confiance."
  path="/agences/"
>
  <div class="wrap section">
    <p class="breadcrumb"><a href="/">Accueil</a> / Nos agences</p>
    <h1>Nos <em>agences</em></h1>
    <p class="lead">Le réseau Godot & Fils s'est développé au fil des années afin de répondre à l'attente de nos clients, avec plus de 200 agences réparties principalement en Île-de-France et sur tout le territoire français.</p>

    <div class="divided-list">
      {agences.map((a) => (
        <div class="agence-row">
          <div class="icon-circle"><Icon name="map-pin" /></div>
          <div class="agence-body">
            <h3>{a.ville}</h3>
            <p>{a.adresse}</p>
          </div>
          <a class="agence-phone" href="tel:0800119119"><Icon name="phone" size={16} /> 0800 119 119</a>
        </div>
      ))}
    </div>

    <div class="card" style="margin-top:24px; text-align:center">
      <p>Cette liste présente une sélection d'agences. Le réseau complet (plus de 200 agences, dont certaines en franchise) est en cours d'intégration.</p>
      <a class="btn" href="/contact/">Nous contacter →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .agence-row { display: flex; align-items: center; gap: 16px; }
  .agence-body { flex: 1; }
  .agence-body h3 { margin: 0 0 2px; }
  .agence-body p { margin: 0; font-size: 14px; }
  .agence-phone { display: flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--accent); white-space: nowrap; }
  @media (max-width: 600px) { .agence-row { flex-wrap: wrap; } .agence-phone { margin-left: 62px; } }
</style>
