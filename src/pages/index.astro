---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';

const faqItems = [
  { q: "L'argent physique est-il un bon investissement ?", a: "L'argent physique est une ressource stable et durable, une alternative accessible à l'or offrant des protections patrimoniales similaires. Contrairement à l'or, l'argent fait peu l'objet de recyclage en raison des coûts élevés, et son usage industriel important (LED, semi-conducteurs, écrans tactiles) peut soutenir la demande sur le long terme." },
  { q: 'Doit-on signaler un achat ou une vente d\'argent aux autorités ?', a: "L'argent n'est pas assujetti à l'ISF/IFI, donc il n'y a aucune déclaration à faire auprès des impôts quel que soit le montant de la transaction." },
  { q: 'Peut-on acheter de l\'argent physique à l\'étranger ?', a: "Il est possible d'acheter de l'argent physique à l'étranger, toutefois la fiscalité peut varier d'un pays à l'autre. Au franchissement d'une frontière, des droits de douane peuvent être prélevés selon la valeur transportée." },
];

const avantages = [
  { icon: 'shield', title: 'Valeur refuge accessible', text: "Un budget plus modeste que l'or pour une protection patrimoniale tangible." },
  { icon: 'search', title: 'Rareté croissante', text: "Peu recyclé, fortement consommé par l'industrie (LED, semi-conducteurs)." },
  { icon: 'package', title: 'Pièces ou lingots', text: "Meilleure liquidité pour les pièces, souvent hors TVA à l'achat." },
  { icon: 'check', title: 'Sans engagement', text: "Conseils et guide d'achat gratuits." },
];

const categories = [
  { label: 'Pièces historiques', title: 'Francs Semeuse & Hercule', img: '/images/silver-coins.jpg', href: '/guide-achat/' },
  { label: 'Pièces modernes', title: 'Silver Eagle & Maple Leaf', img: '/images/hero-silver.jpg', href: '/guide-achat/' },
  { label: 'Lingots', title: "Format compact, hors TVA", img: '/images/silver-bar.jpg', href: '/guide-achat/' },
];

const picks = [
  { title: '5 Francs Semeuse', text: '1959-1969 — démonétisée, statut fiscal des pièces d\'investissement.', img: '/images/silver-coins.jpg' },
  { title: '10 & 50 Francs Hercule', text: 'Argent fin à 900/1000e.', img: '/images/silver-bar.jpg' },
  { title: 'Silver Eagle & Maple Leaf', text: 'Titre de 999/1000e, parmi les plus pures.', img: '/images/hero-silver.jpg' },
  { title: 'Philharmonique & Libertad', text: 'Alternatives autrichienne et mexicaine reconnues.', img: '/images/silver-coins.jpg' },
];
---
<BaseLayout
  title="Acheter de l'argent physique — Acheter Argent"
  description="Achetez des pièces et lingots d'argent physique en toute confiance : conseils, guide d'achat, sélection de pièces reconnues."
  path="/"
>
  <section class="hero-photo" style="background-image:url('/images/hero-dark.jpg')">
    <div class="wrap">
      <p class="kicker">Métaux précieux · Argent physique</p>
      <h1>Découvrez l'éclat de l'<em>argent</em> physique</h1>
      <p class="lead">Pièces et lingots d'argent, conseils d'investissement, guide d'achat — pour investir sereinement dans les métaux précieux.</p>
      <div class="hero-actions">
        <a class="btn" href="/guide-achat/">Guide d'achat →</a>
        <a class="btn-outline" href="/contact/">Nous contacter</a>
      </div>
    </div>
  </section>

  <div class="category-cards">
    {categories.map((c) => (
      <a class="category-card" href={c.href}>
        <div class="ph"><img src={c.img} alt={c.title} loading="eager" /></div>
        <span class="cat-label">{c.label}</span>
        <h3>{c.title}</h3>
        <span class="more">Découvrir →</span>
      </a>
    ))}
  </div>

  <section class="section wrap">
    <div class="icon-feature-row">
      {avantages.map((a) => (
        <div class="icon-feature">
          <div class="icon-circle"><Icon name={a.icon} /></div>
          <h4>{a.title}</h4>
          <p>{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="carousel-head">
        <div>
          <h2>Quelles pièces choisir ?</h2>
          <p class="lead">Des références reconnues internationalement, de la pièce française historique aux frappes modernes les plus pures.</p>
        </div>
      </div>
      <div class="carousel-row">
        {picks.map((p) => (
          <div class="c-card">
            <div class="ph"><img src={p.img} alt={p.title} loading="lazy" /></div>
            <h4>{p.title}</h4>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
      <p style="text-align:center;margin-top:24px"><a class="btn" href="/guide-achat/">Consulter le guide d'achat →</a></p>
    </div>
  </section>

  <section class="section wrap split-feature">
    <div class="ph"><img src="/images/vault.jpg" alt="Chambre forte sécurisée" loading="lazy" /></div>
    <div>
      <h2>Notre approche</h2>
      <p class="lead">Achat de pièces et de lingots d'argent, conseils personnalisés, conditionnement sous sachets scellés numérotés pour la traçabilité de vos biens.</p>
      <a class="btn-outline" href="/a-propos/">En savoir plus →</a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Questions fréquentes</h2>
      <Faq items={faqItems} />
      <p style="text-align:center;margin-top:18px"><a href="/faq/">Voir toutes les questions →</a></p>
    </div>
  </section>

  <section class="section wrap">
    <div class="card cta-final">
      <h2>Une question ? Un projet d'achat ?</h2>
      <p>Écrivez-nous, nous vous répondons rapidement.</p>
      <a class="btn" href="/contact/">Nous contacter →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-final { text-align: center; }
</style>
